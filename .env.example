# ============================================================
# BioLearn AI V1.0 配置模板
# 复制为 .env 后按需修改；start.bat 首次运行会自动复制。
# 永远不要提交真实密钥。
# ============================================================

APP_NAME=BioLearn AI API
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

# 数据库（SQLite）。相对路径相对于 backend 目录，无论从哪里启动都一致。
DATABASE_URL=sqlite:///./data/biolearn.db

# 本地同源部署时，浏览器访问 http://127.0.0.1:8000 不产生跨域；
# 这里列出常用本地来源，便于开发模式（Vite 5173）调试。
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:5173","http://127.0.0.1:5173"]
# 手机/局域网额外来源（仅在需要时填写，例如电脑局域网地址 + 端口）
CORS_EXTRA_ORIGINS=[]

# ---------------------------------------------------------------
# 局域网与访问口令（默认保持仅本机可访问）
# ---------------------------------------------------------------
# 留空 = 不启用口令（仅建议本机或可信局域网使用）。
# 需要手机访问时请设置一个随机口令，手机 App 的“连接设置”里填同样的值。
ACCESS_TOKEN=
# true 等价于启动时加 --lan（监听 0.0.0.0）。默认 false 只监听本机。
ALLOW_LAN=false

# 仅用于开发模式（start-dev.bat 的 Vite 5173）。
# 生产同源部署留空即可，前端会自动使用当前访问地址的 /api/v1。
VITE_API_BASE_URL=

# 7C：本地 SQLite/私有文件实验开关。默认 false；仅 Android 原生可用。
# 运行时也可在 /settings/local-db 切换。不得用它自动迁移真实数据或自动上传。
VITE_MOBILE_LOCAL_DB=false

# 后端直接托管前端构建产物（推荐：单端口运行整个系统）
SERVE_FRONTEND=true
FRONTEND_DIST_DIR=./frontend/dist
LOG_LEVEL=info
LOG_DIR=./data/logs

# 资料存储与解析
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=26214400
CHUNK_MAX_CHARS=6000
CHUNK_MIN_CHARS=600

# AI 服务（OpenAI 兼容 chat/completions）
# 也可以直接在页面“AI 设置”填写；密钥只保存在后端 data/ai_config.json。
AI_PROVIDER=openai-compatible
AI_CONFIG_PATH=./data/ai_config.json
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
AI_TEMPERATURE=0.2
# 请求 OpenAI 兼容接口的 JSON 模式；若服务商拒绝 response_format 会自动降级重试一次。
AI_JSON_MODE=true
AI_MAX_POINTS_PER_CHUNK=8
AI_EXTRACTION_CONCURRENCY=3
AI_MERGE_BATCH_SIZE=40
AI_OUTLINE_MAX_CHARS=15000
