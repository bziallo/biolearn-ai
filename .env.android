# Android build environment overrides.
#
# The normal `.env` targets the local development backend
# (VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1). That address is meaningless
# inside the APK, so the Android mode explicitly clears it. The app then asks
# the user for the laptop's LAN address (or uses VITE_DEFAULT_API_BASE_URL when
# a deployment build sets one).
VITE_API_BASE_URL=
VITE_DEFAULT_API_BASE_URL=
